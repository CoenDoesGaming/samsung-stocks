<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OneUIStocks">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Periodic Background Sync JobService -->
        <service
            android:name=".StockSyncJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Boot, Package Replace, and Periodic Sync Receiver -->
        <receiver
            android:name=".StockAutoSyncReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.oneui.stocks.ACTION_AUTO_SYNC" />
            </intent-filter>
        </receiver>

        <!-- LOCK SCREEN WIDGETS (Samsung One UI lockAndAod + Native Blur) -->

        <!-- 1. Symbol with Graph (2x1 Lock Screen Widget) -->
        <receiver
            android:name=".StockGraphSmallWidgetProvider"
            android:exported="true"
            android:label="@string/widget_graph_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.oneui.stocks.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stock_graph_small_widget_info" />
        </receiver>

        <!-- 2. Symbol (1x1 Lock Screen Widget) -->
        <receiver
            android:name=".StockSymbolTinyWidgetProvider"
            android:exported="true"
            android:label="@string/widget_symbol_tiny_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.oneui.stocks.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stock_symbol_tiny_widget_info" />
        </receiver>

        <!-- 3. Symbol (2x1 Lock Screen Widget) -->
        <receiver
            android:name=".StockSymbolSmallWidgetProvider"
            android:exported="true"
            android:label="@string/widget_symbol_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.oneui.stocks.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stock_symbol_small_widget_info" />
        </receiver>

        <!-- 4. Watchlist (2x1 Lock Screen Widget) -->
        <receiver
            android:name=".StockWatchlistSmallWidgetProvider"
            android:exported="true"
            android:label="@string/widget_watchlist_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.oneui.stocks.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stock_watchlist_small_widget_info" />
        </receiver>

        <!-- HOME SCREEN WIDGETS (2x1, 2x2, 4x1, 4x2 - Synced to Selected Lock Screen Symbol) -->

        <!-- 5. Stock Pill (2x1 Home Screen Widget) -->
        <receiver
            android:name=".StockHome2x1WidgetProvider"
            android:exported="true"
            android:label="@string/widget_home_2x1_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.oneui.stocks.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stock_home_2x1_widget_info" />
        </receiver>

        <!-- 6. Stock Card (2x2 Home Screen Widget) -->
        <receiver
            android:name=".StockHome2x2WidgetProvider"
            android:exported="true"
            android:label="@string/widget_home_2x2_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.oneui.stocks.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stock_home_2x2_widget_info" />
        </receiver>

        <!-- 7. Stock Wide Pill (4x1 Home Screen Widget) -->
        <receiver
            android:name=".StockHome4x1WidgetProvider"
            android:exported="true"
            android:label="@string/widget_home_4x1_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.oneui.stocks.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stock_home_4x1_widget_info" />
        </receiver>

        <!-- 8. Stock Large Card (4x2 Home Screen Widget) -->
        <receiver
            android:name=".StockHome4x2WidgetProvider"
            android:exported="true"
            android:label="@string/widget_home_4x2_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.oneui.stocks.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stock_home_4x2_widget_info" />
        </receiver>

    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Scaled down (0.68x centered at 54,54) so the One UI 7 gradient background stands out prominently -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.68"
        android:scaleY="0.68">

        <!-- 1. Soft 3D Drop Shadow Beneath Main Glyph -->
        <path
            android:fillColor="#290D1642"
            android:pathData="M31,73 C31,70.2 33.2,68 36,68 C38.8,68 41,70.2 41,73 L41,75 C41,77.8 38.8,80 36,80 C33.2,80 31,77.8 31,75 Z" />
        <path
            android:fillColor="#290D1642"
            android:pathData="M49,64 C49,61.2 51.2,59 54,59 C56.8,59 59,61.2 59,64 L59,75 C59,77.8 56.8,80 54,80 C51.2,80 49,77.8 49,75 Z" />
        <path
            android:fillColor="#290D1642"
            android:pathData="M67,54 C67,51.2 69.2,49 72,49 C74.8,49 77,51.2 77,54 L77,75 C77,77.8 74.8,80 72,80 C69.2,80 67,77.8 67,75 Z" />

        <!-- 2. Frosted Translucent White One UI 7 Bar Pillars -->
        <!-- Left Bar Pillar -->
        <path android:pathData="M31,64 C31,61.2 33.2,59 36,59 C38.8,59 41,61.2 41,64 L41,73 C41,75.8 38.8,78 36,78 C33.2,78 31,75.8 31,73 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="36"
                    android:endY="78"
                    android:startX="36"
                    android:startY="59"
                    android:type="linear">
                    <item
                        android:color="#D9EBF3FF"
                        android:offset="0.0" />
                    <item
                        android:color="#8CAEE0FF"
                        android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Middle Bar Pillar -->
        <path android:pathData="M49,57 C49,54.2 51.2,52 54,52 C56.8,52 59,54.2 59,57 L59,73 C59,75.8 56.8,78 54,78 C51.2,78 49,75.8 49,73 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="54"
                    android:endY="78"
                    android:startX="54"
                    android:startY="52"
                    android:type="linear">
                    <item
                        android:color="#D9EBF3FF"
                        android:offset="0.0" />
                    <item
                        android:color="#85A8DAFF"
                        android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Right Tall Bar Pillar -->
        <path android:pathData="M67,47 C67,44.2 69.2,42 72,42 C74.8,42 77,44.2 77,47 L77,73 C77,75.8 74.8,78 72,78 C69.2,78 67,75.8 67,73 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="72"
                    android:endY="78"
                    android:startX="72"
                    android:startY="42"
                    android:type="linear">
                    <item
                        android:color="#E6F2F7FF"
                        android:offset="0.0" />
                    <item
                        android:color="#8CA6D9FF"
                        android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 3. Soft Shadow Under the Main White Stocks Trend Line -->
        <path
            android:fillColor="#00000000"
            android:pathData="M29,56 L44,41 L55,50 L75,30"
            android:strokeColor="#330B1546"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="8.5" />

        <!-- 4. Main Pure White Stocks Trend Curve + Upward Arrowhead -->
        <path
            android:fillColor="#00000000"
            android:pathData="M29,54 L44,39 L55,48 L75,28"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="8.2">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:endX="76"
                    android:endY="56"
                    android:startX="28"
                    android:startY="26"
                    android:type="linear">
                    <item
                        android:color="#FFFFFFFF"
                        android:offset="0.0" />
                    <item
                        android:color="#FFFFFFFF"
                        android:offset="0.72" />
                    <item
                        android:color="#FFE4ECFF"
                        android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Rounded White Arrowhead Wing at Top-Right (75,28) -->
        <path
            android:fillColor="#00000000"
            android:pathData="M61,28 L75,28 L75,42"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="8.2" />

    </group>

</vector>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_widget_card"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="14dp"
    android:paddingEnd="22dp"
    android:paddingBottom="14dp">

    <!-- Top Centered Header (matching MON, 9 NOV in 4x2 reference) -->
    <TextView
        android:id="@+id/home_4x2_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="▼ AUDUSD=X · AUD/USD"
        android:textColor="#FFD0DDD7"
        android:textSize="14.5sp"
        android:textStyle="bold" />

    <!-- Center Hero Price (matching 6:03:23 in 4x2 reference) -->
    <TextView
        android:id="@+id/home_4x2_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="0.687"
        android:textColor="#FFFFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <!-- Subtitle Change + Percent (matching am in 4x2 reference) -->
    <TextView
        android:id="@+id/home_4x2_change"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="-0.004 (-0.58%)"
        android:textColor="#FFFF453A"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <!-- Full-Width Sparkline Underneath -->
    <ImageView
        android:id="@+id/home_4x2_graph"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:contentDescription="Stock performance graph"
        android:scaleType="fitXY" />

</LinearLayout>

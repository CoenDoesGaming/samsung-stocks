<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- ONE UI VIEWING AREA (Top ~36% of screen when expanded, collapses smoothly on scroll) -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="276dp"
        android:background="#FF000000"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="#FF000000"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:titleEnabled="false">

            <!-- Centered Large Title + Date in the Viewing Area -->
            <LinearLayout
                android:id="@+id/expanded_viewing_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="52dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.5">

                <TextView
                    android:id="@+id/tv_expanded_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Stocks"
                    android:textColor="#FF9AD8BC"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/tv_header_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="9 November"
                    android:textColor="#FF96ABA2"
                    android:textSize="15.5sp" />
            </LinearLayout>

            <!-- Action Bar Row at the Bottom of the Viewing Area (Right at the Interaction Area line!) -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/oneui_toolbar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_gravity="bottom"
                android:background="#FF000000"
                app:contentInsetEnd="14dp"
                app:contentInsetStart="22dp"
                app:layout_collapseMode="pin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Collapsed Title (Appears when Viewing Area is collapsed) -->
                    <TextView
                        android:id="@+id/tv_collapsed_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:alpha="0"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Stocks"
                        android:textColor="#FF9AD8BC"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- "Done" Pill Button (Shown when Edit Watchlist Mode is active) -->
                    <TextView
                        android:id="@+id/btn_done_editing"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_tab_selected_pill"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Done"
                        android:textColor="#FF82DFB5"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Right-Aligned One UI Action Icons (Search, More) at Thumb-Reach Line -->
                    <ImageButton
                        android:id="@+id/btn_top_search"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Search symbols"
                        android:padding="9dp"
                        android:src="@drawable/ic_search"
                        app:tint="#FFA5CBB9" />

                    <ImageButton
                        android:id="@+id/btn_more"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="More options"
                        android:padding="9dp"
                        android:src="@drawable/ic_more_vert"
                        app:tint="#FFA5CBB9" />
                </LinearLayout>

            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ONE UI INTERACTION AREA (Starts in comfortable thumb reach) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="always"
        android:paddingTop="4dp"
        android:paddingBottom="96dp"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TAB 1: STOCKS WATCHLIST ONLY -->
            <LinearLayout
                android:id="@+id/section_watchlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- One UI Section Subheader: "My Symbols" -->
                <TextView
                    android:id="@+id/tv_my_symbols_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:text="My Symbols"
                    android:textColor="#FF96ABA2"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <!-- One UI Rounded Focus Block for Watchlist Rows -->
                <LinearLayout
                    android:id="@+id/watchlist_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_focus_block"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <!-- Subtle Yahoo Finance Sync Status Footer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="yahoo!finance"
                        android:textColor="#FF6E7D76"
                        android:textSize="13sp"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:id="@+id/tv_sync_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Live quotes"
                        android:textColor="#FF6E7D76"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- TAB 2: NEWS & BIG MOVERS TODAY TAB -->
            <LinearLayout
                android:id="@+id/section_news_full"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Section 1: Big Movers Today -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:text="Big movers today"
                    android:textColor="#FF96ABA2"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/movers_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_focus_block"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <!-- Section 2: Business & Market News Articles -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:text="Business &amp; market news"
                    android:textColor="#FF96ABA2"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_focus_block"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:id="@+id/news_full_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- COMPACT NEWER ONE UI FLOATING 2-TAB NAVIGATION BAR -->
    <LinearLayout
        android:id="@+id/floating_bottom_nav"
        android:layout_width="196dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_floating_bottom_nav"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3.5dp">

        <!-- Tab 1: Stocks -->
        <LinearLayout
            android:id="@+id/nav_tab_stocks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selected_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_tab_stocks"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="Stocks"
                android:src="@drawable/ic_tab_stocks"
                app:tint="#FF82DFB5" />

            <TextView
                android:id="@+id/label_tab_stocks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text="Stocks"
                android:textColor="#FF82DFB5"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: News -->
        <LinearLayout
            android:id="@+id/nav_tab_news"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_tab_news"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="News"
                android:src="@drawable/ic_tab_news"
                app:tint="#FFA3B8AE" />

            <TextView
                android:id="@+id/label_tab_news"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text="News"
                android:textColor="#FFA3B8AE"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

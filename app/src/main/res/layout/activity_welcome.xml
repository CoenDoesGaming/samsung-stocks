<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/welcome_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oneui_bg_black"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/welcome_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tv_welcome_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="104dp"
                android:layout_marginBottom="64dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/app_name"
                android:textColor="@color/oneui_accent_mint"
                android:textFontWeight="700"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                style="@style/WelcomeFeatureTitle"
                android:text="@string/welcome_feature_track_title" />

            <TextView
                style="@style/WelcomeFeatureBody"
                android:text="@string/welcome_feature_track_body" />

            <TextView
                style="@style/WelcomeFeatureTitle"
                android:text="@string/welcome_feature_detail_title" />

            <TextView
                style="@style/WelcomeFeatureBody"
                android:text="@string/welcome_feature_detail_body" />

            <TextView
                style="@style/WelcomeFeatureTitle"
                android:text="@string/welcome_feature_widgets_title" />

            <TextView
                style="@style/WelcomeFeatureBody"
                android:text="@string/welcome_feature_widgets_body" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/welcome_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="12dp"
        android:paddingEnd="32dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/welcome_data_note"
            android:textColor="@color/oneui_text_tertiary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_welcome_start"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="@drawable/bg_welcome_start_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="200dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/welcome_start"
            android:textColor="#FF0B1F16"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_widget_pill"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <!-- Left: Symbol + Name -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/home_4x1_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="▼ AUDUSD=X"
            android:textColor="#FFFFFFFF"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_4x1_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="AUD/USD"
            android:textColor="#FF96ABA2"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Middle: Sparkline -->
    <ImageView
        android:id="@+id/home_4x1_graph"
        android:layout_width="86dp"
        android:layout_height="34dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="Stock performance graph"
        android:scaleType="fitXY" />

    <!-- Right: Large Bold Price + Change % on Baseline (matching 6:03:23 am in 4x1 reference) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/home_4x1_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="0.687"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_4x1_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="-0.58%"
            android:textColor="#FFFF453A"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

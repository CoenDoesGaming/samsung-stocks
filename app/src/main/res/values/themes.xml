<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OneUIStocks" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/oneui_bg_black</item>
        <item name="android:navigationBarColor">@color/oneui_bg_black</item>
        <item name="android:windowBackground">@color/oneui_bg_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/oneui_accent_blue</item>
        <item name="colorPrimaryVariant">@color/oneui_bg_black</item>
        <item name="colorOnPrimary">@color/oneui_text_primary</item>
    </style>

    <style name="WelcomeFeatureTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/oneui_text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="WelcomeFeatureBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">30dp</item>
        <item name="android:textColor">@color/oneui_text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
</resources>
